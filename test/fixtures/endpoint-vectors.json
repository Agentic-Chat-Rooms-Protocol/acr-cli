    { "name": "ipv6-loopback", "input": "http://[::1]:20443", "valid": true, "normalized": "http://[::1]:20443" },
    { "name": "ipv6-loopback-custom-port-slash", "input": "http://[::1]:30000/", "valid": true, "normalized": "http://[::1]:30000" },
    { "name": "https-rejected", "input": "https://127.0.0.1:20443", "valid": false },
    { "name": "wildcard-zero-rejected", "input": "http://0.0.0.0:20443", "valid": false },
    { "name": "lan-ip-rejected", "input": "http://192.168.1.5:20443", "valid": false },
    { "name": "localhost-lookalike-rejected", "input": "http://localhost.evil.com:20443", "valid": false },
    { "name": "localhost-trailing-dot-rejected", "input": "http://localhost.:20443", "valid": false },
    { "name": "ipv4-lookalike-rejected", "input": "http://127.0.0.1.evil.com:20443", "valid": false },
    { "name": "decimal-ip-rejected", "input": "http://2130706433:20443", "valid": false },
    { "name": "hex-ip-rejected", "input": "http://0x7f.0.0.1:20443", "valid": false },
    { "name": "short-ipv4-rejected", "input": "http://127.1:20443", "valid": false },
    { "name": "ipv4-mapped-ipv6-rejected", "input": "http://[::ffff:127.0.0.1]:20443", "valid": false },
    { "name": "userinfo-rejected", "input": "http://user:pw@127.0.0.1:20443", "valid": false },
    { "name": "api-path-rejected", "input": "http://127.0.0.1:20443/api", "valid": false },
    { "name": "non-root-path-rejected", "input": "http://127.0.0.1:20443/mcp", "valid": false },
    { "name": "query-rejected", "input": "http://127.0.0.1:20443/?next=http://evil.com", "valid": false },
    { "name": "query-no-slash-rejected", "input": "http://127.0.0.1:20443?x=1", "valid": false },
    { "name": "empty-query-rejected", "input": "http://127.0.0.1:20443?", "valid": false },
    { "name": "fragment-rejected", "input": "http://127.0.0.1:20443/#frag", "valid": false },
    { "name": "fragment-no-slash-rejected", "input": "http://127.0.0.1:20443#frag", "valid": false },
    { "name": "empty-fragment-rejected", "input": "http://127.0.0.1:20443#", "valid": false },
    { "name": "privileged-port-rejected", "input": "http://127.0.0.1:80", "valid": false },
    { "name": "over-max-port-rejected", "input": "http://127.0.0.1:65536", "valid": false },
    { "name": "high-invalid-port-rejected", "input": "http://127.0.0.1:70000", "valid": false },
    { "name": "trailing-colon-empty-port-rejected", "input": "http://127.0.0.1:", "valid": false },
    { "name": "scheme-relative-rejected", "input": "//127.0.0.1:20443", "valid": false },
    { "name": "empty-string-rejected", "input": "", "valid": false }
  ],
  "validateRemote": [
    { "name": "canonical-remote", "input": "https://mcp.agentchatrooms.dev/mcp", "valid": true },
    { "name": "canonical-case-insensitive-host", "input": "https://MCP.AgentChatRooms.dev/mcp", "valid": true },
    { "name": "explicit-443-allowed", "input": "https://mcp.agentchatrooms.dev:443/mcp", "valid": true },
    { "name": "http-rejected", "input": "http://mcp.agentchatrooms.dev/mcp", "valid": false },
    { "name": "trailing-dot-rejected", "input": "https://mcp.agentchatrooms.dev./mcp", "valid": false },
    { "name": "lookalike-subdomain-rejected", "input": "https://mcp.agentchatrooms.dev.evil.com/mcp", "valid": false },
    { "name": "userinfo-at-rejected", "input": "https://mcp.agentchatrooms.dev@evil.com/mcp", "valid": false },
    { "name": "userinfo-pw-rejected", "input": "https://user:pw@mcp.agentchatrooms.dev/mcp", "valid": false },
    { "name": "alternate-port-rejected", "input": "https://mcp.agentchatrooms.dev:8443/mcp", "valid": false },
    { "name": "trailing-colon-empty-port-rejected", "input": "https://mcp.agentchatrooms.dev:/mcp", "valid": false },
    { "name": "trailing-slash-rejected", "input": "https://mcp.agentchatrooms.dev/mcp/", "valid": false },
    { "name": "percent-encoded-path-rejected", "input": "https://mcp.agentchatrooms.dev/%6dcp", "valid": false },
    { "name": "query-redirect-rejected", "input": "https://mcp.agentchatrooms.dev/mcp?next=//evil.com", "valid": false },
    { "name": "empty-query-rejected", "input": "https://mcp.agentchatrooms.dev/mcp?", "valid": false },
    { "name": "fragment-rejected", "input": "https://mcp.agentchatrooms.dev/mcp#frag", "valid": false },
    { "name": "empty-fragment-rejected", "input": "https://mcp.agentchatrooms.dev/mcp#", "valid": false },
    { "name": "scheme-relative-rejected", "input": "//mcp.agentchatrooms.dev/mcp", "valid": false },
    { "name": "empty-string-rejected", "input": "", "valid": false }

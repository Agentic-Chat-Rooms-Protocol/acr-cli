  "resolveMode": [
    {
      "name": "no-credential-defaults-local",
      "override": "",
      "entitlement": "none",
      "localUrl": "http://127.0.0.1:20443",
      "expectError": false,
      "expectMode": "local",
      "expectUrl": "http://127.0.0.1:20443"
    },
    {
      "name": "free-tier-defaults-local",
      "override": "",
      "entitlement": "free",
      "localUrl": "http://localhost:20443",
      "expectError": false,
      "expectMode": "local",
      "expectUrl": "http://127.0.0.1:20443"
    },
    {
      "name": "pro-entitlement-selects-remote",
      "override": "",
      "entitlement": "pro",
      "localUrl": "http://127.0.0.1:20443",
      "expectError": false,
      "expectMode": "remote",
      "expectUrl": "https://mcp.agentchatrooms.dev/mcp"
    },
    {
      "name": "enterprise-entitlement-selects-remote",
      "override": "",
      "entitlement": "enterprise",
      "localUrl": "http://127.0.0.1:20443",
      "expectError": false,
      "expectMode": "remote",
      "expectUrl": "https://mcp.agentchatrooms.dev/mcp"
    },
    {
      "name": "paid-user-forces-local",
      "override": "local",
      "entitlement": "pro",
      "localUrl": "http://127.0.0.1:20443",
      "expectError": false,
      "expectMode": "local",
      "expectUrl": "http://127.0.0.1:20443"
    },
    {
      "name": "free-user-forces-remote-no-silent-fallback",
      "override": "remote",
      "entitlement": "free",
      "localUrl": "http://127.0.0.1:20443",
      "expectError": false,
      "expectMode": "remote",
      "expectUrl": "https://mcp.agentchatrooms.dev/mcp"
    },
    {
      "name": "invalid-local-url-fails-even-when-remote-active",
      "override": "remote",
      "entitlement": "pro",
      "localUrl": "http://192.168.1.50:20443",
      "expectError": true
    },
    {
      "name": "unknown-override-rejected",
      "override": "cloud",
      "entitlement": "pro",
      "localUrl": "http://127.0.0.1:20443",
      "expectError": true
    }
  ],
  "daemonGuards": [
    { "name": "local-ipv4-valid-token", "method": "POST", "path": "/api/v1/config/security", "host": "127.0.0.1:20443", "origin": "", "auth": "valid", "expectStatus": 200, "handlerReached": true },
    { "name": "local-ipv6-valid-token", "method": "POST", "path": "/api/v1/config/security", "host": "[::1]:20443", "origin": "", "auth": "valid", "expectStatus": 200, "handlerReached": true },
    { "name": "allowlisted-origin-valid-token", "method": "POST", "path": "/api/v1/rooms", "host": "localhost:20443", "origin": "https://agentchatrooms.dev", "auth": "valid", "expectStatus": 200, "handlerReached": true },
    { "name": "allowlisted-origin-config-mutation-rejected", "method": "POST", "path": "/api/v1/config/security", "host": "localhost:20443", "origin": "https://agentchatrooms.dev", "auth": "valid", "expectStatus": 403, "handlerReached": false },
    { "name": "dns-rebinding-host-rejected", "method": "POST", "path": "/api/v1/config/security", "host": "evil.com:20443", "origin": "", "auth": "valid", "expectStatus": 403, "handlerReached": false },
    { "name": "lan-host-default-allowlist-rejected", "method": "POST", "path": "/api/v1/config/security", "host": "192.168.1.5:20443", "origin": "", "auth": "valid", "expectStatus": 403, "handlerReached": false },
    { "name": "evil-origin-no-token-rejected", "method": "POST", "path": "/api/v1/config/security", "host": "127.0.0.1:20443", "origin": "https://evil.com", "auth": "none", "expectStatus": 403, "handlerReached": false },
    { "name": "evil-origin-valid-token-rejected", "method": "POST", "path": "/api/v1/config/security", "host": "127.0.0.1:20443", "origin": "https://evil.com", "auth": "valid", "expectStatus": 403, "handlerReached": false },
    { "name": "mutation-no-token-rejected", "method": "POST", "path": "/api/v1/config/security", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "expectStatus": 401, "handlerReached": false },
    { "name": "wrong-token-rejected", "method": "POST", "path": "/api/v1/config/security", "host": "127.0.0.1:20443", "origin": "", "auth": "wrong", "expectStatus": 401, "handlerReached": false },
    { "name": "read-no-token-rejected", "method": "GET", "path": "/api/v1/rooms", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "expectStatus": 401, "handlerReached": false },
    { "name": "sse-no-token-rejected", "method": "GET", "path": "/api/v1/stream", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "expectStatus": 401, "handlerReached": false },
    { "name": "webhook-no-token-rejected", "method": "POST", "path": "/webhooks/gitea", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "expectStatus": 401, "handlerReached": false },
    { "name": "health-public", "method": "GET", "path": "/api/v1/health", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "expectStatus": 200, "handlerReached": true },
    { "name": "auth-challenge-public", "method": "POST", "path": "/api/v1/auth/challenge", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "expectStatus": 200, "handlerReached": true },
    { "name": "auth-verify-public", "method": "POST", "path": "/api/v1/auth/verify", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "expectStatus": 200, "handlerReached": true },
    { "name": "preflight-allowlisted-origin", "method": "OPTIONS", "path": "/api/v1/rooms", "host": "127.0.0.1:20443", "origin": "https://agentchatrooms.dev", "auth": "none", "enablePna": true, "expectStatus": 204, "expectPna": true, "handlerReached": false },
    { "name": "preflight-evil-origin-rejected", "method": "OPTIONS", "path": "/api/v1/rooms", "host": "127.0.0.1:20443", "origin": "https://evil.com", "auth": "none", "expectStatus": 403, "handlerReached": false },
    { "name": "preflight-without-origin-rejected", "method": "OPTIONS", "path": "/api/v1/rooms", "host": "127.0.0.1:20443", "origin": "", "auth": "none", "requireAuth": false, "expectStatus": 403, "handlerReached": false }
  ]
}

{
  "schemaVersion": "1.0.0",
  "remoteUrl": "https://mcp.agentchatrooms.dev/mcp",
  "defaultLocalUrl": "http://127.0.0.1:20443",
  "oauth": {
    "issuer": "https://clerk.agentchatrooms.dev",
    "scopesSupported": ["profile", "email"],
    "forbiddenClientScopes": ["acr:rooms", "acr:cloud:pro"]
  },
  "validateLocal": [

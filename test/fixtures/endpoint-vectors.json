    { "name": "localhost-uppercase-root-slash", "input": "http://LOCALHOST:20443/", "valid": true, "normalized": "http://127.0.0.1:20443" },
    { "name": "localhost-root-slash", "input": "http://localhost:20499/", "valid": true, "normalized": "http://127.0.0.1:20499" },
    { "name": "localhost-omitted-port", "input": "http://localhost", "valid": true, "normalized": "http://127.0.0.1:20443" },
    { "name": "ipv4-omitted-port-root-slash", "input": "http://127.0.0.1/", "valid": true, "normalized": "http://127.0.0.1:20443" },
